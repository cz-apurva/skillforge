# ==============================================================================
# SkillForge AI - Backend Core Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=development

# 1. PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillforge

# 2. Google Gemini API Configuration (via @google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
AI_MODE=live
LLM_PROVIDER=gemini

# 3. Authentication & Security (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# 4. FairGrade Python FastAPI Microservice
FAIRGRADE_SERVICE_URL=http://localhost:8000

# 5. Judge0 Code Sandbox Execution
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# 6. YouTube Data API v3 (Optional)
YOUTUBE_API_KEY=
